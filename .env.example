# Full Postgres connection string; takes precedence over the DB_* parts below.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ainoc

# Individual Postgres connection parts (used when DATABASE_URL is unset).
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ainoc

# AWS region for Bedrock briefing generation.
# BEDROCK_REGION=us-east-1

# Bedrock model/inference-profile ID for briefings.
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Dev-only demo data seeding. Never set in production.
# SEED_DEMO_DATA=true

# Number of trusted proxy hops in front of Express.
# TRUST_PROXY_HOPS=1

# Shared secret verifying requests came through the CDN.
# ORIGIN_VERIFY_TOKEN=
